{{- /* Declare variables */ -}}
{{- $minimal := false -}}

{{- if (env "DOTFILES_MINIMAL") -}}
{{- $minimal = true -}}
{{- end }}

{{- /* Checks if running interactively, which is not the case for GitHub Codespaces */ -}}
{{- $headless := not stdinIsATTY -}}

{{/* declare variables as empty values to populate below */}}
{{- $name := get . "name" | default "" -}}
{{- $email := get . "email" | default "" -}}

// See: https://raw.githubusercontent.com/benmezger/dotfiles/150e1d16faa0a975e110ae9f10745c15be79b186/.chezmoi.yaml.tmpl
// finish defining what is important to me and templating from EVs, Prompts, or default values
{{- if (env "ASK") }}
  {{- $minimal = promptBool "minimal (skip Brew bundle)" -}}

  {{- $name = promptString "full name" $name -}}
  {{- $email = promptString "email" $email -}}
{{/* Add defaults for when ASK is not provided */}}
{{- else if (or (eq (env "GITHUB_USER") "jls5177") (has (env "USER") (list "simoju" "simonjus"))) -}}
  {{- $name = get . "name" | default "Justin Simon" -}}
  {{- $email = get . "email" | default "jls5177@gmail.com" -}}
{{- end -}}

{{- if not $headless -}}
{{-   writeToStdout "💡 Tip: you can re-enter your name and email with `chezmoi init --data=false`.\n" -}}
{{- end -}}

{{- $osversion := .chezmoi.os -}}
{{- if hasKey .chezmoi.osRelease "versionID" -}}
{{-   $osversion = printf "%s" .chezmoi.osRelease.versionID -}}
{{- end -}}

{{- $osid := .chezmoi.os -}}
{{- if hasKey .chezmoi.osRelease "id" -}}
{{-   $osid = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}

sourceDir: "{{ .chezmoi.sourceDir }}"

{{/* Secrets are encrypted in-repo with age, unlocked by a passphrase-protected
     identity (home/key.txt.age). Requires the `age` binary (installed by the
     bootstrap). The recipient (public key) is safe to commit. */}}
encryption: "age"
age:
  command: "age"
  identity: "{{ .chezmoi.sourceDir }}/key.txt.age"
  recipient: "age1vqfhhvafqhc2xucsu9s8w4nwj0x8v08jh0wufq0qs3r35dafupxs8ez66x"

data:
  config_state:
    headless: {{ $headless }}
    minimal: {{ $minimal }}
  name: {{ $name }}
  email: {{ $email }}
  osid: {{ $osid | quote }}
  osversion: {{ $osversion | quote }}
