# Ubuntu-specific Homebrew bundle (all arches, including aarch64).
#
# Shared cross-platform tools live in Brewfile-common (bundled after this file).
# Only list packages here that are wanted on Ubuntu but not everywhere.

# --- Taps ---
tap "bgreenwell/lstr"
tap "charmbracelet/tap"

# --- CLI utilities ---
brew "dust"            # Nicer du, written in Rust
brew "eza"             # Modern replacement for ls
brew "lnav"            # Log file viewer/analyzer

# --- Build tools ---
brew "meson"           # Fast, user-friendly build system

# --- Python ---
brew "tox"             # Virtualenv-based test runner
brew "pdm"             # Python package/dependency manager
brew "hatch"           # Python project management
brew "jupyterlab"      # JupyterLab notebook environment

# --- Docs ---
brew "pandoc-crossref" # Pandoc numbering/cross-referencing filter

# --- Cloud / infra ---
brew "azure-cli"       # Microsoft Azure CLI
brew "ollama"          # Run local LLMs

# --- Embedded / repo tooling ---
brew "west"            # Zephyr meta-tool

# --- Charm tools ---
brew "charmbracelet/tap/charm", trusted: true  # Charm cloud/host tool
brew "skate"                                    # Charm personal key-value store

# --- Misc ---
brew "bgreenwell/lstr/lstr", trusted: true      # Fast directory tree viewer
