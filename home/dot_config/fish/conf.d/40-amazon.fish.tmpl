function brc
    if test (count $argv) -ne 1
        echo "Usage: brc <command-string>" >&2
        return 2
    end
    brazil-recursive-cmd (printf 'echo "Executing command in $name" && %s && echo ""' "$argv[1]")
end
function brca
    if test (count $argv) -ne 1
        echo "Usage: brca <command-string>" >&2
        return 2
    end
    brazil-recursive-cmd -all (printf 'echo "Executing command in $name" && %s && echo ""' "$argv[1]")
end
function startOdinTunnel
    stopOdinTunnel; or return
    ssh -f -N -M -S /tmp/odintunnelsession -L 2009:127.0.0.1:2009 "$USER-clouddesk.aka.corp.amazon.com"
end
function stopOdinTunnel
    if test -S /tmp/odintunnelsession
        ssh -S /tmp/odintunnelsession -O exit "$USER-clouddesk.aka.corp.amazon.com"
    end
end
function git-package
    if test (count $argv) -ne 1
        echo "Usage: git-package <package>" >&2
        return 2
    end
    cd "$HOME/code"; or return
    git clone "ssh://git.amazon.com/pkg/$argv[1]"; or return
    cd "$argv[1]"
end
