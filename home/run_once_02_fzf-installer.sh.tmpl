#!/usr/bin/env bash

# enable unofficial bash strict mode
set -euo pipefail
IFS=$'\n\t'

{{ if eq .chezmoi.os "linux" }}

{{ if stat (joinPath .chezmoi.homeDir ".fzf" "install") }}
# Installer hash: {{ include (joinPath .chezmoi.homeDir ".fzf" "install") | sha256sum }}
{{ end }}
if [[ ! -x "${HOME}/.fzf/install" ]]; then
  echo "FZF installer missing at ${HOME}/.fzf/install; refresh the .fzf external and retry." >&2
  exit 1
fi
{{ if eq (includeTemplate "shell" .) "fish" }}
~/.fzf/install --bin
{{ else }}
~/.fzf/install --no-update-rc --completion --key-bindings --no-bash --no-fish --no-nushell
{{ end }}

{{ end }}
