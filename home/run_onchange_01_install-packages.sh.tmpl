#!/usr/bin/env bash

# enable unofficial bash strict mode
set -euo pipefail
IFS=$'\n\t'

# Use Chezmoi to get source root as it runs the script from temp files
HOME_ROOT="{{ .chezmoi.sourceDir }}"
SRC_ROOT=$(cd "${HOME_ROOT}"/.. && pwd -P)
source "${SRC_ROOT}/scripts/common.sh"

DRYRUN="${DRYRUN:-false}"

log::always "Running: ${BASH_SOURCE}"

run_bundle() {
  local brewfile="${1}"
  shift
  if [[ "${DRYRUN}" == "true" ]]; then
    log::always "DRYRUN" "$(ansi --green "brew bundle --no-lock --file \"${brewfile}\"")"
  else
    brew bundle install --no-lock --file "${brewfile}"
  fi
}

{{ if eq .chezmoi.os "darwin" }}

# Only install Homebrew packages if not deploying minimal version
{{ if not .config_state.minimal }}
log::always "Installing MacOSX Homebrew packages"

# Install primary homebrew packages
# Brewfile hash: {{ include "Brewfile" | sha256sum }}
run_bundle "${HOME_ROOT}/Brewfile"

log::always "💡 Post install steps to run Yabai" \
"    1) Disable System Protection: https://github.com/koekeishiya/yabai/wiki/Disabling-System-Integrity-Protection"

# Install Apple Silicon specific packages
{{ if eq .chezmoi.arch "arm64" }}
log::always "Installing MacOSX ARM64 Homebrew packages"

# Brewfile-Darwin-arm64 hash: {{ include "Brewfile-Darwin-arm64" | sha256sum }}
run_bundle "${HOME_ROOT}/Brewfile-Darwin-arm64"
{{end}}

# Install Amzn homebrew packages
{{- if (and (hasKey . "email") (hasSuffix "@amazon.com" .email)) }}
log::always "Installing Amzn Homebrew packages"

# Amzn Brewfile hash: {{ include "Brewfile-Amzn" | sha256sum }}
run_bundle "${HOME_ROOT}/Brewfile-Amzn"
{{ end }}

# Install Msft homebrew packages
{{- if (and (hasKey . "email") (hasSuffix "@microsoft.com" .email)) }}
log::always "Installing Msft Homebrew packages"

# Amzn Brewfile hash: {{ include "Brewfile-Msft" | sha256sum }}
run_bundle "${HOME_ROOT}/Brewfile-Msft"
{{ end }}

{{ else }}
log::always "$(ansi --yellow "Skipping Homebrew package install due to minimal config")"
{{ end }}
{{ end }}

{{- if eq .osid "linux-ubuntu" }}
log::always "Detected Ubuntu OS"

# Install Ubuntu packages
log::always "Installing Ubuntu packages"
sudo apt install -y zsh direnv byobu python3 python-is-python3 virtualenv sshpass net-tools golang python3-pip unzip

# Install Charmbracelet (Gum) applications
log::always "Installing Charmbracelet packages"
{{- if lt .osversion "24.04" }}
log::always "Installing Golang from homebrew as Ubunut 22.04 does not have Golang 20 or greater"
# fallback to homebrew on Ubuntu 22.04 as Golang is stuck at v18
brew install go
{{ end }}
go install github.com/charmbracelet/gum@latest

{{ end }}
